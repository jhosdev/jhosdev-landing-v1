---
// "The Machine": a surveillance-HUD title sequence that acquires, classifies and
// resolves the site owner as "the asset", then settles into a calm 12s idle loop.
// The frame is a pure function of time (window.seek(seconds), or ?seek=12.5 to
// freeze), so it can be captured frame-by-frame to video. Every fact on screen
// comes from the resume data; machine-speak comes from machine/copy.ts.
import { getContent } from '../data/content';
import { getResume, type Locale } from '../data/resume';
import { machineCopy } from './machine/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const { basics, meta } = getResume(locale);

const data = {
  handle: content.promptUser,
  name: basics.name,
  role: basics.label,
  location: [basics.location.city, basics.location.countryCode].filter(Boolean).join(', '),
  headline: content.headline[1],
  stamp: meta.lastModified ?? '',
  stats: content.stats,
  projects: content.projects.map(({ slug, statusLabel, tags }) => ({ slug, status: statusLabel, tags })),
  stack: content.stack,
  experience: content.experience.map(({ period, title, company }) => ({ period, title, company })),
};
---

<div class="machine">
  <canvas data-machine={JSON.stringify(data)} data-copy={JSON.stringify(machineCopy[locale].scene)} aria-hidden="true"></canvas>
  <button type="button" class="machine-replay" data-machine-replay>$ ./machine --replay</button>
</div>

<style>
  .machine {
    position: relative;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  canvas {
    width: 100%;
    max-width: none;
    height: min(calc(100svh - 49px), 820px);
    min-height: 480px;
  }

  .machine-replay {
    position: absolute;
    right: 28px;
    bottom: -30px;
    padding: 4px 0;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
    cursor: pointer;
  }

  .machine-replay:hover,
  .machine-replay:focus-visible {
    color: var(--color-green);
  }

  @media (max-width: 720px) {
    canvas {
      height: min(calc(100svh - 120px), 640px);
    }

    .machine-replay {
      right: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .machine-replay {
      display: none;
    }
  }
</style>

<script>
  import { createMachine, introName, INTRO, LOOP, type MachineData } from './machine/scene';
  import type { SceneCopy } from './machine/copy';

  async function init(cv: HTMLCanvasElement) {
    const params = new URLSearchParams(location.search);
    const frozen = params.get('seek');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const machine = await createMachine(cv, JSON.parse(cv.dataset.machine ?? '{}') as MachineData, {
      copy: JSON.parse(cv.dataset.copy ?? '{}') as SceneCopy,
      calm: still && frozen === null,
      intro: introName(params.get('intro')),
    });
    if (!machine) return;
    // Reduced motion gets the settled idle frame, once.
    let current = frozen !== null ? Number(frozen) || 0 : still ? INTRO + 4 : 0;
    machine.render(current);

    const host = window as unknown as { seek: (s: number) => void; DURATION: number };
    host.seek = (s) => machine.render((current = s));
    host.DURATION = INTRO + LOOP;
    if (frozen !== null || still) return;

    // The clock only runs while the scene is on screen.
    let visible = false;
    let raf = 0;
    let prev = 0;
    const tick = (now: number) => {
      current += Math.min(0.1, (now - prev) / 1000);
      prev = now;
      machine.render(current);
      raf = visible ? requestAnimationFrame(tick) : 0;
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !raf) {
        prev = performance.now();
        raf = requestAnimationFrame(tick);
      }
    }).observe(cv);
    cv.parentElement?.querySelector('[data-machine-replay]')?.addEventListener('click', () => (current = 0));
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-machine]').forEach(init);
</script>
